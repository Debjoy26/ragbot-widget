# Placeholders only. The worker never receives VISITOR_TOKEN_SECRET or chat keys it doesn't use.
# `npm run dev:worker` loads worker/.env only (not the root .env). The worker refuses to start
# if VISITOR_TOKEN_SECRET (or TURNSTILE_SECRET_KEY, RATE_LIMIT_KEY_SECRET, or a rotated copy)
# is present in its environment. Every limit below is required: there are no defaults, and a
# missing or invalid value stops the worker at start-up. The numbers shown are examples to edit,
# not recommendations; the owner sets the real values.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SECRET_KEY=<server-only-secret-key>
LOG_LEVEL=info
# Optional base name (letters, digits . _ : - only, at most 56 characters). The worker id is always
# <base>-<random>; without WORKER_ID the base is <host>-<pid>. The suffix is new on every start.
# WORKER_ID=

# --- Timeouts (milliseconds) ---
DB_TIMEOUT_MS=10000
STORAGE_TIMEOUT_MS=60000

# --- Job queue ---
# Jobs running at once in this process (1..100).
WORKER_CONCURRENCY=2
# Lease on a claimed job (5..3600 s). The heartbeat interval must be at most a third of it, and
# DB_TIMEOUT_MS must be at most half of it.
JOB_LEASE_SECONDS=120
JOB_HEARTBEAT_INTERVAL_SECONDS=30
JOB_POLL_INTERVAL_MS=2000
# Retry delay: min(max, base * 2^(attempt-1)) with jitter (1..3600 s).
JOB_BACKOFF_BASE_SECONDS=15
JOB_BACKOFF_MAX_SECONDS=900
# On SIGTERM/SIGINT running jobs may finish for this long, then they are aborted.
SHUTDOWN_GRACE_MS=25000

# --- Maintenance and retention (P6, status 3a ae and av) ---
MAINTENANCE_INTERVAL_SECONDS=300
# Batch for sessions, runs, reservations, conversations, entries, jobs and uploads (1..10000;
# abandoned-upload cleanup is capped at 1000 per pass).
RETENTION_BATCH_SIZE=500
# Batch for rate-limit buckets, caches and usage records (1..100000).
PURGE_BATCH_SIZE=5000
# Must be at least CHAT_DEADLINE_MS/1000 + 60 s (the API's chat deadline; keep the two equal).
CHAT_DEADLINE_MS=60000
STUCK_RUN_THRESHOLD_SECONDS=300
VISITOR_SESSION_GRACE_SECONDS=3600
TERMINAL_JOB_RETENTION_DAYS=30
# At least 24.
ABANDONED_UPLOAD_HOURS=24

# --- Extraction limits (max bytes and max pages come from the bot's upload policy) ---
# Hard cap on one download (bytes); the cap actually used is the smallest of this, the version's
# registered byte_size and the bot's max_bytes.
WORKER_MAX_DOWNLOAD_BYTES=52428800
# Most chunks one version may produce (1..1000000); more fails the version as unsupported.
MAX_CHUNKS_PER_VERSION=5000
# Extracted text over this many characters fails the version as unsupported.
EXTRACT_MAX_CHARS=5000000
EXTRACT_TIMEOUT_MS=120000
EXTRACT_CHILD_MEMORY_MB=512

# --- Embedding cost estimate (budget reservations) ---
# Chunks per provider call (1..200).
EMBEDDING_BATCH_SIZE=64
# US dollars per million input tokens for EMBEDDING_MODEL. Check the provider's price list.
EMBEDDING_PRICE_PER_MILLION_TOKENS=0.15

# --- Analysis cost estimate (budget reservations, P9-T2) ---
# US dollars per million input/output tokens for ANALYSIS_MODEL. Check the price list.
ANALYSIS_PRICE_INPUT_PER_MILLION_TOKENS=0.10
ANALYSIS_PRICE_OUTPUT_PER_MILLION_TOKENS=0.40

# --- AI providers (ADR 0014). Switch vendor/model by editing these only. ---
# Providers: gemini | openai | anthropic | openai_compatible
# Key lookup: <ROLE>_API_KEY, else the provider key below. openai_compatible needs
# <ROLE>_API_KEY and <ROLE>_BASE_URL (https; http only for localhost).
GEMINI_API_KEY=<gemini-key>
OPENAI_API_KEY=<openai-key-if-used>
ANTHROPIC_API_KEY=<anthropic-key-if-used>
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=1536
ANALYSIS_PROVIDER=gemini
ANALYSIS_MODEL=gemini-2.5-flash-lite

# --- Cache warming (C8, P7.5). Opt-in and default-off: without WARM_ENABLED=true
# the worker starts and warming stays inert. With true, every WARM_* value below
# is required and validated; a missing or invalid value stops the worker.
# The chat/moderation identities MUST equal the API's CHAT_*/MODERATION_* values
# so warmed cache keys match live lookups (same provider/model/format). No
# separate warming keys exist by design: the registry reuses the key of the
# already-configured embedding/analysis role whose vendor matches, and refuses
# to start when no held key matches. No API-only secret ever reaches the worker.
WARM_ENABLED=false
WARM_CONTEXT_MAX_TOKENS=8000
WARM_MAX_OUTPUT_TOKENS=1000
WARM_MAX_OUTPUT_CHARS=4000
WARM_TOP_K=5
WARM_MIN_SIMILARITY=0.3
WARM_DEADLINE_MS=30000
# Must outlive WARM_DEADLINE_MS plus a 60 s margin.
WARM_RESERVE_TTL_SECONDS=300
WARM_MODERATION_MAX_CHARS=2000
WARM_EMBEDDING_PRICE_PER_MILLION_TOKENS=0.15
WARM_CHAT_PRICE_INPUT_PER_MILLION=0.5
WARM_CHAT_PRICE_OUTPUT_PER_MILLION=1.5
WARM_MODERATION_PRICE_INPUT_PER_MILLION=0.2
WARM_MODERATION_PRICE_OUTPUT_PER_MILLION=0.8
WARM_CHAT_PROVIDER=gemini
WARM_CHAT_MODEL=gemini-2.5-flash-lite
# Optional fallback pair: both or neither.
# WARM_CHAT_FALLBACK_PROVIDER=openai
# WARM_CHAT_FALLBACK_MODEL=gpt-4o-mini
WARM_MODERATION_PROVIDER=openai
WARM_MODERATION_MODEL=omni-moderation-latest
# endpoint | llm_classifier (must equal the API's moderation mode).
WARM_MODERATION_MODE=endpoint
