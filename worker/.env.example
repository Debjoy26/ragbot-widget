# Placeholders only. The worker never receives VISITOR_TOKEN_SECRET or chat keys it doesn't use.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SECRET_KEY=<server-only-secret-key>
LOG_LEVEL=info

# --- AI providers (ADR 0014). Switch vendor/model by editing these only. ---
# Providers: gemini | openai | anthropic | openai_compatible
# Key lookup: <ROLE>_API_KEY, else the provider key below. openai_compatible needs
# <ROLE>_API_KEY and <ROLE>_BASE_URL (https; http only for localhost).
GEMINI_API_KEY=<gemini-key>
OPENAI_API_KEY=<openai-key-if-used>
ANTHROPIC_API_KEY=<anthropic-key-if-used>
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=1536
ANALYSIS_PROVIDER=gemini
ANALYSIS_MODEL=gemini-2.5-flash-lite
