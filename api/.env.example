# Placeholders only. Real values: local .env (gitignored) or Render env.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SECRET_KEY=<server-only-secret-key>
VISITOR_TOKEN_SECRET=<random-32+-byte-secret>
TURNSTILE_SECRET_KEY=<turnstile-secret>
ALLOWED_ORIGINS=https://client.example.com
PORT=8080
LOG_LEVEL=info

# --- AI providers (ADR 0014). Switch vendor/model by editing these only. ---
# Providers: gemini | openai | anthropic | openai_compatible
# Key lookup: <ROLE>_API_KEY, else the provider key below. openai_compatible needs
# <ROLE>_API_KEY and <ROLE>_BASE_URL (https; http only for localhost).
GEMINI_API_KEY=<gemini-key>
OPENAI_API_KEY=<openai-key-if-used>
ANTHROPIC_API_KEY=<anthropic-key-if-used>
CHAT_PRIMARY_PROVIDER=gemini
CHAT_PRIMARY_MODEL=gemini-2.5-flash-lite
# Optional fallback — use a different provider for independent quota:
CHAT_FALLBACK_PROVIDER=
CHAT_FALLBACK_MODEL=
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=1536
MODERATION_PROVIDER=gemini
MODERATION_MODEL=gemini-2.5-flash-lite
# endpoint (openai only) | llm_classifier
MODERATION_MODE=llm_classifier
