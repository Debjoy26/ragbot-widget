# Placeholders only. Real values: local api/.env (gitignored) or Render env.
# `npm run dev:api` loads api/.env only (not the root .env).
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SECRET_KEY=<server-only-secret-key>
VISITOR_TOKEN_SECRET=<random-32+-byte-secret>
# Leave empty when the Turnstile challenge is off (bots with turnstile_required=false
# never verify); challenge-required requests then fail closed. Real secret only:
# Cloudflare's published always-pass/always-fail test secrets are refused at startup.
TURNSTILE_SECRET_KEY=
# HMAC key for rate-limit bucket keys, so no plain IP or identifier reaches the database.
# At least 32 bytes; must differ from every other secret here. Changing it resets all counters.
RATE_LIMIT_KEY_SECRET=<random-32+-byte-secret>
# Optional, for rotating VISITOR_TOKEN_SECRET: the retired secret. Tokens signed with it are still
# accepted (until they expire); new tokens never use it. Leave unset when not rotating. All of the
# secrets above (and this one) must differ from each other.
# VISITOR_TOKEN_SECRET_PREVIOUS=<previous-32+-byte-secret>
# Exact origins, comma-separated, no wildcard (https; http only for localhost). CORS is not authentication.
ALLOWED_ORIGINS=https://client.example.com
# TCP port to listen on.
PORT=8080
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# --- Server limits (P4). All required; there are no defaults. Values below are placeholders to tune. ---
# Number of trusted reverse proxies in front of the API (0 = ignore X-Forwarded-For).
TRUSTED_PROXY_HOPS=<integer-0-to-10>
# Maximum request body size in bytes.
BODY_LIMIT_BYTES=<bytes>
# Maximum time in ms to receive a complete request (headers and body) before it is dropped. It
# does not bound how long a handler runs.
REQUEST_TIMEOUT_MS=<milliseconds>
# Idle socket timeout in ms. READY_TIMEOUT_MS must be smaller than this: a socket that sends
# nothing for this long is closed, even while a handler is still working.
CONNECTION_TIMEOUT_MS=<milliseconds>
# Upper bound in ms for the /health/ready database probe.
READY_TIMEOUT_MS=<milliseconds>
# Bound on each database request from the API.
DB_TIMEOUT_MS=<milliseconds>
# Lifetime in seconds of an issued visitor token (60-86400, as the database requires).
VISITOR_TOKEN_TTL_SECONDS=<seconds-60-to-86400>
# Bot-independent limit on POST /v1/sessions per client IP bucket, counted before any bot lookup:
# at most SESSION_PREFLIGHT_PER_IP_LIMIT attempts (1-1000000) per SESSION_PREFLIGHT_WINDOW_SECONDS (1-86400).
SESSION_PREFLIGHT_PER_IP_LIMIT=<attempts>
SESSION_PREFLIGHT_WINDOW_SECONDS=<seconds-1-to-86400>
# Bound in ms on one Cloudflare Turnstile verification call. A timeout counts as a failed challenge.
TURNSTILE_TIMEOUT_MS=<milliseconds>
# Overall deadline in ms for one chat answer, including retries and fallback.
CHAT_DEADLINE_MS=<milliseconds>
# Maximum attempts per provider call, including the first (1-10). Required and validated, but
# the chat pipeline does not read it: its retries are CHAT_PROVIDER_ATTEMPTS below.
PROVIDER_MAX_ATTEMPTS=<integer-1-to-10>

# --- Chat pipeline (P7). All required; there are no defaults. Values below are placeholders to tune. ---
# Chunks fetched per question (1-50) and the minimum cosine similarity (0-1) a chunk needs to count
# as evidence. The threshold is calibrated per embedding model on real data; there is no universal value.
RETRIEVAL_TOP_K=<integer-1-to-50>
RETRIEVAL_MIN_SIMILARITY=<decimal-0-to-1>
# Upper bound in estimated tokens (3 characters per token) on one chat prompt: system, history,
# evidence and question. The API refuses to start below the smallest value that can hold the system
# prompt (with the largest bot text), a 2000-character question and one evidence chunk: 3339 for the
# current prompt template (computed in api/src/lib/context-budget.ts, which lists the assumptions).
# The budget reservation counts the longest such prompt at 1 character = 1 token.
CHAT_CONTEXT_MAX_TOKENS=<tokens-at-least-3339>
# Most prior messages (server-side history) put in a prompt (0-50; 0 turns history off).
CHAT_HISTORY_MAX_MESSAGES=<integer-0-to-50>
# Output token cap per chat call.
CHAT_MAX_OUTPUT_TOKENS=<tokens>
# Hard cap on the characters of one answer (at least 100). When it is exceeded the stream is
# aborted, the text received up to the cap is kept and the turn is stored as partial. The budget
# reservation also counts output moderation of this many characters at 1 character = 1 token.
CHAT_MAX_OUTPUT_CHARS=<characters>
# Total attempts per provider before the first token, including the first (1-3). After a token is
# received there is never a retry or a fallback.
CHAT_PROVIDER_ATTEMPTS=<integer-1-to-3>
# Lifetime in seconds of the budget reservation made for one chat request (1-86400). It must be
# at least 30 seconds longer than CHAT_DEADLINE_MS (CHAT_RESERVATION_TTL_SECONDS * 1000 >=
# CHAT_DEADLINE_MS + 30000).
CHAT_RESERVATION_TTL_SECONDS=<seconds>
# Page size of GET /v1/conversations/:id (1-100).
HISTORY_PAGE_SIZE=<integer-1-to-100>
# Rate limit on GET /v1/conversations/:id, per visitor session: at most
# HISTORY_RATE_PER_SESSION_LIMIT (>= 1) reads per HISTORY_RATE_WINDOW_SECONDS (1-86400).
HISTORY_RATE_PER_SESSION_LIMIT=<reads>
HISTORY_RATE_WINDOW_SECONDS=<seconds-1-to-86400>
# Prices in USD per million tokens, used for the budget reservation and the usage ledger. Every
# price must be greater than 0 (a free price would make the budget meaningless); set the real price
# even when a provider is free. The provider's billing stays the final authority. The two
# CHAT_FALLBACK_PRICE_* are required exactly when CHAT_FALLBACK_PROVIDER is set, and refused
# otherwise.
CHAT_PRICE_INPUT_PER_MILLION=<usd-per-million-input-tokens>
CHAT_PRICE_OUTPUT_PER_MILLION=<usd-per-million-output-tokens>
# CHAT_FALLBACK_PRICE_INPUT_PER_MILLION=<usd-per-million-input-tokens>
# CHAT_FALLBACK_PRICE_OUTPUT_PER_MILLION=<usd-per-million-output-tokens>
MODERATION_PRICE_INPUT_PER_MILLION=<usd-per-million-input-tokens>
MODERATION_PRICE_OUTPUT_PER_MILLION=<usd-per-million-output-tokens>
EMBEDDING_PRICE_PER_MILLION_TOKENS=<usd-per-million-tokens>

# --- AI providers (ADR 0014). Switch vendor/model by editing these only. ---
# A value that still looks like a <placeholder> in a key the config uses stops startup.
# Providers: gemini | openai | anthropic | openai_compatible
# Key lookup: <ROLE>_API_KEY, else the provider key below. openai_compatible needs
# <ROLE>_API_KEY and <ROLE>_BASE_URL (https; http only for localhost).
GEMINI_API_KEY=<gemini-key>
OPENAI_API_KEY=<openai-key-if-used>
ANTHROPIC_API_KEY=<anthropic-key-if-used>
CHAT_PRIMARY_PROVIDER=gemini
CHAT_PRIMARY_MODEL=gemini-3.5-flash-lite
# Optional fallback — use a different provider for independent quota:
CHAT_FALLBACK_PROVIDER=
CHAT_FALLBACK_MODEL=
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=1536
MODERATION_PROVIDER=gemini
MODERATION_MODEL=gemini-3.5-flash-lite
# endpoint (openai only) | llm_classifier
MODERATION_MODE=llm_classifier
