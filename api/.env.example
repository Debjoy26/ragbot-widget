# Placeholders only. Real values: local api/.env (gitignored) or Render env.
# `npm run dev:api` loads api/.env only (not the root .env).
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SECRET_KEY=<server-only-secret-key>
VISITOR_TOKEN_SECRET=<random-32+-byte-secret>
# Real secret only: Cloudflare's published always-pass/always-fail test secrets are refused at startup.
TURNSTILE_SECRET_KEY=<turnstile-secret>
# HMAC key for rate-limit bucket keys, so no plain IP or identifier reaches the database.
# At least 32 bytes; must differ from every other secret here. Changing it resets all counters.
RATE_LIMIT_KEY_SECRET=<random-32+-byte-secret>
# Optional, for rotating VISITOR_TOKEN_SECRET: the retired secret. Tokens signed with it are still
# accepted (until they expire); new tokens never use it. Leave unset when not rotating. All of the
# secrets above (and this one) must differ from each other.
# VISITOR_TOKEN_SECRET_PREVIOUS=<previous-32+-byte-secret>
# Exact origins, comma-separated, no wildcard (https; http only for localhost). CORS is not authentication.
ALLOWED_ORIGINS=https://client.example.com
# TCP port to listen on.
PORT=8080
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# --- Server limits (P4). All required; there are no defaults. Values below are placeholders to tune. ---
# Number of trusted reverse proxies in front of the API (0 = ignore X-Forwarded-For).
TRUSTED_PROXY_HOPS=<integer-0-to-10>
# Maximum request body size in bytes.
BODY_LIMIT_BYTES=<bytes>
# Maximum time in ms to receive a complete request (headers and body) before it is dropped. It
# does not bound how long a handler runs.
REQUEST_TIMEOUT_MS=<milliseconds>
# Idle socket timeout in ms. READY_TIMEOUT_MS must be smaller than this: a socket that sends
# nothing for this long is closed, even while a handler is still working.
CONNECTION_TIMEOUT_MS=<milliseconds>
# Upper bound in ms for the /health/ready database probe.
READY_TIMEOUT_MS=<milliseconds>
# Bound on each database request from the API.
DB_TIMEOUT_MS=<milliseconds>
# Lifetime in seconds of an issued visitor token (60-86400, as the database requires).
VISITOR_TOKEN_TTL_SECONDS=<seconds-60-to-86400>
# Bot-independent limit on POST /v1/sessions per client IP bucket, counted before any bot lookup:
# at most SESSION_PREFLIGHT_PER_IP_LIMIT attempts (1-1000000) per SESSION_PREFLIGHT_WINDOW_SECONDS (1-86400).
SESSION_PREFLIGHT_PER_IP_LIMIT=<attempts>
SESSION_PREFLIGHT_WINDOW_SECONDS=<seconds-1-to-86400>
# Bound in ms on one Cloudflare Turnstile verification call. A timeout counts as a failed challenge.
TURNSTILE_TIMEOUT_MS=<milliseconds>
# Overall deadline in ms for one chat answer, including retries and fallback.
CHAT_DEADLINE_MS=<milliseconds>
# Maximum attempts per provider call, including the first (1-10).
PROVIDER_MAX_ATTEMPTS=<integer-1-to-10>

# --- AI providers (ADR 0014). Switch vendor/model by editing these only. ---
# A value that still looks like a <placeholder> in a key the config uses stops startup.
# Providers: gemini | openai | anthropic | openai_compatible
# Key lookup: <ROLE>_API_KEY, else the provider key below. openai_compatible needs
# <ROLE>_API_KEY and <ROLE>_BASE_URL (https; http only for localhost).
GEMINI_API_KEY=<gemini-key>
OPENAI_API_KEY=<openai-key-if-used>
ANTHROPIC_API_KEY=<anthropic-key-if-used>
CHAT_PRIMARY_PROVIDER=gemini
CHAT_PRIMARY_MODEL=gemini-2.5-flash-lite
# Optional fallback — use a different provider for independent quota:
CHAT_FALLBACK_PROVIDER=
CHAT_FALLBACK_MODEL=
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=1536
MODERATION_PROVIDER=gemini
MODERATION_MODEL=gemini-2.5-flash-lite
# endpoint (openai only) | llm_classifier
MODERATION_MODE=llm_classifier
