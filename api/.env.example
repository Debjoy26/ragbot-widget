# Placeholders only. Real values: local api/.env (gitignored) or Render env.
# `npm run dev:api` loads api/.env only (not the root .env).
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SECRET_KEY=<server-only-secret-key>
VISITOR_TOKEN_SECRET=<random-32+-byte-secret>
TURNSTILE_SECRET_KEY=<turnstile-secret>
# Exact origins, comma-separated, no wildcard (https; http only for localhost). CORS is not authentication.
ALLOWED_ORIGINS=https://client.example.com
# TCP port to listen on.
PORT=8080
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# --- Server limits (P4). All required; there are no defaults. Values below are placeholders to tune. ---
# Number of trusted reverse proxies in front of the API (0 = ignore X-Forwarded-For).
TRUSTED_PROXY_HOPS=<integer-0-to-10>
# Maximum request body size in bytes.
BODY_LIMIT_BYTES=<bytes>
# Maximum time in ms to receive a complete request before it is dropped.
REQUEST_TIMEOUT_MS=<milliseconds>
# Idle socket timeout in ms.
CONNECTION_TIMEOUT_MS=<milliseconds>
# Upper bound in ms for the /health/ready database probe.
READY_TIMEOUT_MS=<milliseconds>
# Bound on each database request from the API.
DB_TIMEOUT_MS=<milliseconds>
# Lifetime in seconds of an issued visitor token.
VISITOR_TOKEN_TTL_SECONDS=<seconds>
# Overall deadline in ms for one chat answer, including retries and fallback.
CHAT_DEADLINE_MS=<milliseconds>
# Maximum attempts per provider call, including the first (1-10).
PROVIDER_MAX_ATTEMPTS=<integer-1-to-10>

# --- AI providers (ADR 0014). Switch vendor/model by editing these only. ---
# Providers: gemini | openai | anthropic | openai_compatible
# Key lookup: <ROLE>_API_KEY, else the provider key below. openai_compatible needs
# <ROLE>_API_KEY and <ROLE>_BASE_URL (https; http only for localhost).
GEMINI_API_KEY=<gemini-key>
OPENAI_API_KEY=<openai-key-if-used>
ANTHROPIC_API_KEY=<anthropic-key-if-used>
CHAT_PRIMARY_PROVIDER=gemini
CHAT_PRIMARY_MODEL=gemini-2.5-flash-lite
# Optional fallback — use a different provider for independent quota:
CHAT_FALLBACK_PROVIDER=
CHAT_FALLBACK_MODEL=
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=1536
MODERATION_PROVIDER=gemini
MODERATION_MODEL=gemini-2.5-flash-lite
# endpoint (openai only) | llm_classifier
MODERATION_MODE=llm_classifier
