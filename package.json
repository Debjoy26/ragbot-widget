{
  "name": "ragbot-widget",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.22.2"
  },
  "workspaces": [
    "shared",
    "api",
    "worker",
    "widget"
  ],
  "scripts": {
    "build": "tsc -b && npm run build -w widget",
    "typecheck": "tsc -b && tsc -p widget --noEmit && tsc -p tests --noEmit",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "playwright test --pass-with-no-tests",
    "db:start": "supabase start",
    "db:migrate:dev": "supabase db reset",
    "dev:api": "npm run dev -w api",
    "dev:worker": "npm run dev -w worker",
    "dev:widget": "npm run dev -w widget",
    "clean": "tsc -b --clean && node -e \"require('node:fs').rmSync('widget/dist',{recursive:true,force:true})\"",
    "test:db": "supabase test db",
    "secret-scan": "bash scripts/secret-scan.sh",
    "secret-scan:self-test": "bash scripts/secret-scan.sh --self-test"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "esbuild": "0.28.2",
    "eslint": "10.14.0",
    "globals": "17.14.0",
    "prettier": "3.9.10",
    "supabase": "3.0.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.1.0"
  }
}
